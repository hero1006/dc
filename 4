#Server Program

import socket

s = socket.socket()
s.bind(("localhost", 6666))
s.listen(1)

print("Server waiting for client...")
c, addr = s.accept()

a = int(c.recv(1024).decode())
b = int(c.recv(1024).decode())

print("Sum =", a + b)

c.close()
s.close()
#client program
import socket

c = socket.socket()
c.connect(("localhost", 6666))

a = input("Enter 1st number: ")
b = input("Enter 2nd number: ")

c.send(a.encode())
c.send(b.encode())

c.close()
